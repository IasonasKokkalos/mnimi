license: Apache-2.0
repository-code: "https://github.com/IasonasKokkalos/mnimi"
url: "https://github.com/IasonasKokkalos/mnimi"
keywords:
  - agent-memory
  - llm
  - sqlite
  - sqlite-vec
  - rag
  - long-term-memory
  - longmemeval
